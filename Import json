import os, hashlib, json
from pathlib import Path

TPM_KEY_FILE = Path.home() / ".qfs_tpm_key"

def get_or_create_key():
    if TPM_KEY_FILE.exists():
        return TPM_KEY_FILE.read_bytes()
    k = os.urandom(32)
    TPM_KEY_FILE.write_bytes(k)
    os.chmod(TPM_KEY_FILE, 0o600)
    return k

def sign_authorization(payload_bytes: bytes, secret: bytes) -> str:
    import hmac, hashlib
    return hmac.new(secret, payload_bytes, hashlib.sha256).hexdigest()
